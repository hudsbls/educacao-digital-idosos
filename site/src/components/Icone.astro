const desenho = CAMINHOS[nome] ?? CAMINHOS.alerta;
---

<svg
  class="icone"
  width={tamanho}
  height={tamanho}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={desenho}
/>
