---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { rotulosCanais, iconeCanal, classeCanal } from '../lib/rotulos';

const golpes = (await getCollection('golpes', ({ data }) => !data.rascunho)).sort((a, b) =>
  a.data.titulo.localeCompare(b.data.titulo, 'pt-BR')
);

const destaques = golpes.slice(0, 3);
---

<Base titulo="Início">
  <div class="faixa-alerta">
    <p class="limite">
      <span class="faixa-alerta__selo">Atenção</span>
      Nós nunca pedimos sua senha nem transferência de dinheiro.
      Se alguém pediu, é golpe. <a href="/ajuda/">Saiba o que fazer</a>.
    </p>
  </div>

  <div class="pagina">
    <section class="saudacao">
      <div>
        <p class="saudacao-ola">Olá!</p>
        <h1 class="saudacao-titulo">Aqui você aprende a se proteger.</h1>
        <p class="saudacao-sub">
          Vídeos, explicações simples e um passo a passo do que fazer depois de um golpe.
        </p>
      </div>
      <span class="saudacao-icone"><Icone nome="escudo" tamanho={56} /></span>
    </section>

    <a class="botao-grande" href="/ajuda/">
      Preciso de ajuda
      <span class="botao-sub">Caí num golpe ou estou em dúvida sobre uma ligação ou mensagem</span>
    </a>

    <h2>Golpes mais comuns</h2>
    <p class="meta">Toque em um golpe para ver a explicação e o passo a passo.</p>

    {destaques.map((golpe) => (
      <a class={`card ${classeCanal(golpe.data.canal)}`} href={`/golpes/${golpe.id}/`}>
        <span class="card-icone"><Icone nome={iconeCanal(golpe.data.canal)} tamanho={28} /></span>
        <div class="card-texto">
          <span class="canal">Canal: {rotulosCanais(golpe.data.canal)}</span>
          <h3>{golpe.data.titulo}</h3>
          <p>{golpe.data.resumoCurto}</p>
        </div>
        <span class="card-seta"><Icone nome="seta" tamanho={24} /></span>
      </a>
    ))}

    <a class="botao-grande secundario" href="/golpes/">Ver todos os golpes</a>

    <div class="reconforto">
      <Icone nome="escudo" tamanho={28} />
      <p>
        <strong>Você não está sozinho(a).</strong>
        Cair em um golpe pode acontecer com qualquer pessoa. Há canais oficiais que podem ajudar.
      </p>
    </div>
  </div>
</Base>
