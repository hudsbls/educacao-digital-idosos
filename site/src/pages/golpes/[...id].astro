---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { rotulosCanais, iconeCanal } from '../../lib/rotulos';

export async function getStaticPaths() {
  const golpes = await getCollection('golpes', ({ data }) => !data.rascunho);
  return golpes.map((golpe) => ({ params: { id: golpe.id }, props: { golpe } }));
}

const { golpe } = Astro.props;
const { Content } = await render(golpe);

const outros = (
  await getCollection('golpes', ({ id, data }) => !data.rascunho && id !== golpe.id)
).slice(0, 3);

const dataFormatada = golpe.data.atualizadoEm.toLocaleDateString('pt-BR', { timeZone: 'UTC' });
const video = golpe.data.video;
---

<Base titulo={golpe.data.titulo} descricao={golpe.data.resumoCurto}>
  <div class="pagina">
    <p class="meta"><a href="/golpes/">← Voltar para a lista de golpes</a></p>

    <h1>{golpe.data.titulo}</h1>
    <p class="meta">
      Última atualização: {dataFormatada} · Canal: {rotulosCanais(golpe.data.canal)}
    </p>

    <a class="botao-grande secundario" href="#transcricao">Ir direto para o texto</a>

    {
      video && video.youtubeId ? (
        <div class="video">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}?rel=0&cc_load_policy=1&cc_lang_pref=pt&hl=pt-BR&playsinline=1`}
            title={`Vídeo: ${golpe.data.titulo}`}
            allow="encrypted-media; picture-in-picture"
            allowfullscreen
            loading="lazy"
          />
        </div>
      ) : (
        <p class="aviso-video">
          <Icone nome="video" tamanho={28} />
          <span>
            <strong>Vídeo em produção.</strong> A gravação deste conteúdo faz parte da etapa de
            produção audiovisual. Enquanto isso, leia o texto abaixo — ele tem a mesma informação.
          </span>
        </p>
      )
    }

    <h2>O que é</h2>
    <p>{golpe.data.resumoCurto}</p>

    <h2>Como reconhecer</h2>
    <ul class="lista-sinais">
      {golpe.data.comoReconhecer.map((item) => <li>{item}</li>)}
    </ul>

    <h2>O que fazer agora</h2>
    <ol class="passos">
      {golpe.data.oQueFazerAgora.map((item) => <li>{item}</li>)}
    </ol>

    <p><a class="botao-grande secundario" href="/ajuda/">Ver todos os canais de ajuda</a></p>

    <h2>Envie para alguém</h2>
    <div class="acoes">
      <a href="#transcricao" data-compartilhar>
        <Icone nome="enviar" tamanho={22} />
        Enviar para alguém
      </a>
    </div>

    <details>
      <summary>Mais opções</summary>
      <p class="meta">Se preferir, copie o endereço desta página e envie do seu jeito:</p>
      <p><code data-endereco>{Astro.url.pathname}</code></p>
    </details>

    <section class="transcricao" id="transcricao">
      <h2>Texto do vídeo</h2>
      <Content />
    </section>

    <p class="meta">
      Revisado por: {golpe.data.revisadoPor}. {golpe.data.fontes.join(' ')}
    </p>

    {
      outros.length > 0 && (
        <>
          <h2>Outros golpes</h2>
          {outros.map((outro) => (
            <a class="card" href={`/golpes/${outro.id}/`}>
              <span class="card-topo">
                <Icone nome={iconeCanal(outro.data.canal)} tamanho={26} />
                <span class="canal">Canal: {rotulosCanais(outro.data.canal)}</span>
              </span>
              <h3>{outro.data.titulo}</h3>
              <p>{outro.data.resumoCurto}</p>
            </a>
          ))}
        </>
      )
    }
  </div>

  <script>
    // O link de envio depende do endereço real da página, por isso é montado
    // no navegador. Se o JavaScript estiver desligado, o link leva ao texto.
    const botaoEnviar = document.querySelector('[data-compartilhar]');
    if (botaoEnviar) {
      botaoEnviar.setAttribute(
        'href',
        'https://wa.me/?text=' + encodeURIComponent(document.title + ' — ' + window.location.href)
      );
      botaoEnviar.setAttribute('target', '_blank');
      botaoEnviar.setAttribute('rel', 'noopener');
    }

    const campoEndereco = document.querySelector('[data-endereco]');
    if (campoEndereco) campoEndereco.textContent = window.location.href;
  </script>
</Base>
